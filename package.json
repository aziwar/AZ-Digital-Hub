{
  "name": "az-digital-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website of Ahmed Ziwar, AI consultant in Kuwait: AI strategy, delivery and adoption for mid-sized companies in Kuwait and the GCC",
  "author": "Ahmed Zewar <ahmed@zewar.xyz>",
  "homepage": "https://www.zewar.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/aziwar/AZ-Digital-Hub.git"
  },
  "bugs": {
    "url": "https://github.com/aziwar/AZ-Digital-Hub/issues",
    "email": "ahmed@zewar.xyz"
  },
  "keywords": [
    "ai-consulting",
    "ai-strategy",
    "digital-transformation",
    "kuwait",
    "gcc",
    "next.js",
    "next-intl",
    "typescript"
  ],
  "engines": {
    "node": ">=20.11.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src lib",
    "type-check": "tsc --noEmit",
    "build-check": "npm run build && npm run type-check",
    "stage-1-safety": "node scripts/validation/validate-config.js",
    "stage-2-typescript": "node scripts/validation/validate-typescript.js",
    "stage-3-eslint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "stage-4-dependencies": "npm audit --audit-level=moderate && npm outdated --depth=0",
    "stage-5-build": "next build",
    "quality-gates": "npm run stage-1-safety && npm run stage-2-typescript && npm run stage-3-eslint && npm run stage-4-dependencies && npm run stage-5-build",
    "pre-deploy": "npm run quality-gates",
    "deploy-safe": "npm run pre-deploy && echo 'All quality gates passed - ready for deployment'",
    "validate-all": "npm run stage-1-safety",
    "deployment-safety": "npm run stage-1-safety && echo 'Configuration safety validated'",
    "clean:linux": "rm -rf .next node_modules/.cache",
    "full-clean": "rm -rf .next node_modules package-lock.json && npm install",
    "check-deps": "npm ls",
    "audit-fix": "npm audit fix",
    "perf:baseline": "npm run build && node scripts/performance/compare-bundles.js",
    "perf:compare": "npm run build && node scripts/performance/compare-bundles.js",
    "perf:fps": "npm run dev & sleep 5 && node scripts/performance/measure-fps.js",
    "test:visual:baseline": "playwright test --update-snapshots",
    "test:visual": "playwright test",
    "test:performance": "npm run perf:compare && npm run perf:fps"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.49.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2"
  }
}
