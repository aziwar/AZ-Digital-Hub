# Environment variables template
# Copy to .env.local and fill with your actual values
# NEVER commit .env.local to version control

# Site URL (canonical, sitemap, metadata). Defaults to https://www.zewar.xyz
NEXT_PUBLIC_BASE_URL=https://www.zewar.xyz

# Cloudflare Email Service (primary contact form email provider)
# Token needs "Email Sending: Edit"; the owner inbox must be a verified destination address.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_EMAIL_API_TOKEN=your_email_sending_api_token
# Optional: defaults are ahmed@zewar.xyz and website@zewar.xyz
CONTACT_TO_EMAIL=ahmed@zewar.xyz
CONTACT_FROM_EMAIL=website@zewar.xyz

# EmailJS (fallback contact form provider, used only when Cloudflare is not configured)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# Upstash Redis (optional: shared rate limiting; without it the contact API uses an in-memory limiter)
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Google reCAPTCHA v3 (optional: contact form works without it)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
