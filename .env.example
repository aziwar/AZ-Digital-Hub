# Environment variables template
# Copy to .env.local and fill with your actual values
# NEVER commit .env.local to version control

# Site URL (canonical, sitemap, metadata). Defaults to https://www.zewar.xyz
NEXT_PUBLIC_BASE_URL=https://www.zewar.xyz

# Upstash Redis (optional: rate limiting for /api/health and /api/client-error)
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Talking avatar (off by default; see docs/plans/2026-10-25-talking-avatar.md)
# Values come from Infisical -> Vercel env. Never paste real keys here or in chat.
NEXT_PUBLIC_AVATAR_ENABLED=false
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
ELEVENLABS_API_KEY=your-elevenlabs-api-key
